GOOGLE_CLIENT_ID= # get from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET= # get from https://console.cloud.google.com/apis/credentials
SECRET_KEY= # random
OAUTH_REDIRECT_URI="http://localhost/auth/callback" # set for whatever host you're using
DEBUG="FALSE"
ADMIN_EMAILS= # comma-separated; these accounts get the dashboard's "View as" control

CERTBOT_EMAIL= # Just an email
DOMAIN=localhost # Should be the same as the oauth but without http:// or the /auth/callback
USE_LOCAL_CA=1 # should be 1 for testing, 0 for prod

# Paths. All are relative to the working directory unless absolute, and all have
# the defaults shown, so you only need these to move something.
# PANTOGRAPH_CONFIG=config          # a directory of YAML files, or a single file
# PANTOGRAPH_DB=database.db
# PANTOGRAPH_ANALYTICS_DB=analytics.db
# PANTOGRAPH_ASSETS=assets

# HOST=127.0.0.1                    # 0.0.0.0 inside Docker
# PORT=8050
